<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>0x5ha157: Dashboard</title>
    <style>
        /* --- THEME VARIABLES --- */
        :root {
            /* CYBERPUNK PALETTE */
            --bg-color: #050505;           /* Deep Black */
            --panel-bg: #0f0f0f;           /* Soft Black */
            --text-color: #e6edf3;         /* White-Grey */
            --border-color: #333333;
            
            /* NEON ACCENTS */
            --accent-color: #00ffee;       /* Electric Cyan */
            --success-color: #00ff9d;      /* Neon Mint */
            --warning-color: #ffbf00;      /* Bright Amber */
            --purple-color: #d600ff;       /* Neon Violet */
            --pink-color: #ff0055;         /* Radical Red */
            --linkedin-color: #00aeff;     /* Bright Azure */
            
            --font-stack: 'Consolas', 'Monaco', 'Andale Mono', monospace;
            --shadow: 0 10px 30px rgba(0, 255, 238, 0.05); /* Slight Cyan Glow */
        }

        /* Light Theme (Adjusted for readability) */
        [data-theme="light"] {
            --bg-color: #f6f8fa;
            --panel-bg: #ffffff;
            --text-color: #24292f;
            --accent-color: #009cb8;       /* Darker Cyan */
            --success-color: #00a86b;      /* Darker Mint */
            --warning-color: #d49e00;
            --purple-color: #a000bf;
            --pink-color: #d60046;
            --linkedin-color: #0077b5;
            --border-color: #d0d7de;
            --shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        /* RGB Theme (Gamer Mode) */
        [data-theme="rgb"] {
            --bg-color: #000000;
            --panel-bg: #000000;
            --text-color: #00ff00;         /* Matrix Green Text */
            --accent-color: #ff00ff;       /* Magenta */
            --success-color: #00ff00;
            --warning-color: #ffff00;
            --purple-color: #00ffff;       /* Cyan */
            --pink-color: #ff0000;         /* Red */
            --linkedin-color: #0000ff;
            --border-color: #00ff00;
            --shadow: 0 0 15px #00ff00;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-stack);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 1rem;
            transition: background-color 0.3s, color 0.3s;
        }

        .dashboard {
            width: 100%;
            max-width: 700px;
            border: 1px solid var(--border-color);
            background-color: var(--bg-color);
            box-shadow: var(--shadow);
            z-index: 10;
        }

        /* RGB Animation */
        [data-theme="rgb"] .dashboard {
            border: 2px solid transparent;
            animation: border-rgb 2s linear infinite;
        }
        @keyframes border-rgb {
            0% { border-color: #ff0000; box-shadow: 0 0 10px #ff0000; }
            33% { border-color: #00ff00; box-shadow: 0 0 10px #00ff00; }
            66% { border-color: #0000ff; box-shadow: 0 0 10px #0000ff; }
            100% { border-color: #ff0000; box-shadow: 0 0 10px #ff0000; }
        }

        /* --- HEADER --- */
        .header {
            background-color: var(--panel-bg);
            padding: 15px 20px;
            border-bottom: 1px solid var(--border-color);
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
        }

        .header-info { display: flex; flex-direction: column; gap: 2px; }
        .header-title { font-size: 0.95rem; font-weight: bold; }
        .header-meta { font-size: 0.8rem; opacity: 0.7; color: var(--accent-color); }

        .clock-container { text-align: center; }
        #digital-clock {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--text-color);
            letter-spacing: 2px;
            text-shadow: 0 0 8px rgba(0, 255, 238, 0.3); /* Slight glow */
        }

        .theme-toggle {
            display: flex;
            justify-self: end;
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            overflow: hidden;
        }
        .theme-btn {
            background: none; border: none; padding: 6px 12px;
            cursor: pointer; font-size: 0.75rem; font-weight: bold;
            color: var(--text-color); border-right: 1px solid var(--border-color);
            font-family: var(--font-stack); opacity: 0.6;
        }
        .theme-btn:last-child { border-right: none; }
        .theme-btn.active { background-color: var(--accent-color); color: #000; opacity: 1; }

        /* --- STATS --- */
        .stats-row {
            display: flex; justify-content: space-between;
            padding: 15px 20px; border-bottom: 1px solid var(--border-color);
            font-size: 0.85rem; color: var(--warning-color);
        }

        /* --- SERVICES --- */
        .services { padding: 20px; }
        .service-item {
            display: flex; justify-content: space-between; align-items: center;
            padding: 15px; margin-bottom: 10px;
            border: 1px solid var(--border-color); background-color: var(--panel-bg);
            text-decoration: none; color: var(--text-color);
            transition: all 0.2s; cursor: pointer;
        }
        .service-item:hover { 
            border-color: var(--accent-color); 
            transform: translateX(5px); 
            box-shadow: -2px 0 10px rgba(0, 255, 238, 0.1);
        }
        .service-name { font-weight: bold; font-size: 1.1rem; }
        .service-desc { font-size: 0.8rem; color: #8b949e; margin-top: 3px; }
        
        .status-badge {
            background-color: rgba(255, 255, 255, 0.05);
            color: var(--text-color);
            padding: 4px 8px; border-radius: 4px; font-size: 0.8rem;
            border: 1px solid var(--border-color); white-space: nowrap;
        }

        /* --- FOOTER --- */
        .footer { 
            padding: 10px 20px; 
            font-size: 0.8rem; 
            color: #666; 
            border-top: 1px solid var(--border-color); 
            display: flex;
            justify-content: space-between;
            align-items: center;
            min-height: 50px;
        }

        .rune-container {
            background: #000;
            border: 1px solid #333;
            padding: 5px 10px;
            font-family: 'Courier New', monospace;
            font-size: 0.8rem;
            color: var(--purple-color); 
            width: 160px;
            height: 32px;
            line-height: 20px;
            overflow: hidden;
            text-align: center;
            cursor: pointer;
            user-select: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: border-color 0.2s;
        }
        .rune-container:hover { border-color: var(--purple-color); }

        .footer-right { text-align: right; }
        .secret-link { text-decoration: none; color: inherit; cursor: default; }
        .cursor { display: inline-block; width: 8px; height: 1em; background-color: var(--success-color); animation: blink 1s step-end infinite; vertical-align: bottom; }
        @keyframes blink { 50% { opacity: 0; } }
        .copyright-line { margin-top: 8px; font-size: 0.7rem; opacity: 0.5; }

        @media (max-width: 600px) {
            .header { grid-template-columns: 1fr; gap: 15px; text-align: center; }
            .theme-toggle { justify-self: center; }
            .stats-row { flex-direction: column; gap: 5px; text-align: center; }
            .footer { flex-direction: column; gap: 15px; text-align: center; height: auto; }
            .footer-right { text-align: center; }
        }
    </style>
</head>
<body>

    <div class="dashboard">
        <div class="header">
            <div class="header-info">
                <span class="header-title">root@0x5ha157-server</span>
                <span id="user-ip" class="header-meta">IP: Scanning...</span>
            </div>
            
            <div class="clock-container">
                <div id="digital-clock">00:00:00</div>
            </div>

            <div class="theme-toggle">
                <button class="theme-btn active" onclick="setTheme('dark')">CMD</button>
                <button class="theme-btn" onclick="setTheme('light')">DAY</button>
                <button class="theme-btn" onclick="setTheme('rgb')">RGB</button>
            </div>
        </div>

        <div class="stats-row">
            <span>CPU: [|||||-----] 12%</span>
            <span>MEM: [||||||----] 4.2GB</span>
            <span>UPTIME: 99.9%</span>
        </div>

        <div class="services">
            <p style="margin-bottom: 15px; color: #666;">> Select a module to launch:</p>

            <a href="about.html" class="service-item">
                <div>
                    <div class="service-name">./ABOUT_ME.sh</div>
                    <div class="service-desc">Resume, Skills, & Professional Experience</div>
                </div>
                <div class="status-badge" style="color: var(--success-color); border-color: var(--success-color);">[ ACTIVE ]</div>
            </a>

            <a href="chat/" class="service-item">
                <div>
                    <div class="service-name">./secure_uplink.sh</div>
                    <div class="service-desc">Encrypted Comms Channel</div>
                </div>
                <div class="status-badge" style="color: var(--accent-color); border-color: var(--accent-color);">[ CONNECT ]</div>
            </a>

            <a href="blogs/" class="service-item">
                <div>
                    <div class="service-name">/var/logs/BLOGS</div>
                    <div class="service-desc">Documentation & Homelab Notes</div>
                </div>
                <div class="status-badge" style="color: var(--success-color); border-color: var(--success-color);">[ MOUNTED ]</div>
            </a>

            <a href="https://card.0x5ha157.xyz" target="_blank" class="service-item">
                <div>
                    <div class="service-name">./ID_CARD.vcf</div>
                    <div class="service-desc">Digital Identity & Contact Info</div>
                </div>
                <div class="status-badge" style="color: var(--success-color); border-color: var(--success-color);">[ VERIFIED ]</div>
            </a>

            <div class="service-item" onclick="copyIP()">
                <div>
                    <div class="service-name">./minecraft_server.jar</div>
                    <div class="service-desc">mc.0x5ha157.xyz (Click to Copy IP)</div>
                </div>
                <div id="mc-badge" class="status-badge" style="color: var(--purple-color); border-color: var(--purple-color);">[ COPY IP ]</div>
            </div>

            <a href="mailto:shashwattripathi.ca@gmail.com" class="service-item">
                <div>
                    <div class="service-name">connect_ssh.py</div>
                    <div class="service-desc">Contact via Email</div>
                </div>
                <div class="status-badge" style="color: var(--warning-color); border-color: var(--warning-color);">[ OPEN PORT ]</div>
            </a>

            <a href="https://linkedin.com/in/shashwattripathi157/" target="_blank" class="service-item">
                <div>
                    <div class="service-name">/usr/bin/linkedin</div>
                    <div class="service-desc">Professional Network</div>
                </div>
                <div class="status-badge" style="color: var(--linkedin-color); border-color: var(--linkedin-color);">[ CONNECT ]</div>
            </a>

            <a href="https://www.instagram.com/0x5ha157/" target="_blank" class="service-item">
                <div>
                    <div class="service-name">./social_media.jpg</div>
                    <div class="service-desc">Personal Gallery</div>
                </div>
                <div class="status-badge" style="color: var(--pink-color); border-color: var(--pink-color);">[ FOLLOW ]</div>
            </a>

        </div>

        <div class="footer">
            <div class="rune-container" onclick="stopRunes()">
                <span id="rune-output">...</span>
            </div>

            <div class="footer-right">
                <div>
                    System Ready. Waiting for input<a href="/packs/" class="secret-link"><span class="cursor"></span></a>
                </div>
                <div class="copyright-line">&copy; 2026 0x5ha157 | Self-Hosted Homelab</div>
            </div>
        </div>
    </div>

    <script>
        // --- IP FETCH ---
        async function fetchUserIP() {
            try {
                const response = await fetch('https://api.ipify.org?format=json');
                const data = await response.json();
                document.getElementById('user-ip').innerText = "IP: " + data.ip;
            } catch (error) { document.getElementById('user-ip').innerText = "IP: 127.0.0.1"; }
        }
        fetchUserIP();

        // --- CLOCK ---
        function updateClock() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            document.getElementById('digital-clock').innerText = `${hours}:${minutes}:${seconds}`;
        }
        setInterval(updateClock, 1000); updateClock();

        // --- COPY IP ---
        function copyIP() {
            navigator.clipboard.writeText("mc.0x5ha157.xyz");
            const badge = document.getElementById("mc-badge");
            badge.innerText = "[ COPIED! ]";
            // Use the CSS variable for background
            badge.style.backgroundColor = "rgba(214, 0, 255, 0.2)"; 
            setTimeout(() => {
                badge.innerText = "[ COPY IP ]";
                badge.style.backgroundColor = "";
            }, 2000);
        }

        // --- THEME ---
        function setTheme(themeName) {
            document.documentElement.setAttribute('data-theme', themeName);
            localStorage.setItem('theme', themeName);
            document.querySelectorAll('.theme-btn').forEach(btn => btn.classList.remove('active'));
            const buttons = document.querySelectorAll('.theme-btn');
            if(themeName === 'dark') buttons[0].classList.add('active');
            if(themeName === 'light') buttons[1].classList.add('active');
            if(themeName === 'rgb') buttons[2].classList.add('active');
        }
        setTheme(localStorage.getItem('theme') || 'dark');

        // --- INFINITE MINECRAFT RUNE SCRIPT ---
        const runes = "ᔑʖᓵ↸ᒷ⎓⊣⍑╎⋮ꖎᒲリ𝙹!¡ᑑ∷ᓭℸ ̣ ⚍⍊ᐑ̇/||⨅";
        const targetText = "SYSTEM READY";
        const runeOutput = document.getElementById("rune-output");
        const runeBox = document.querySelector(".rune-container");
        let isRunning = true;
        
        function randomRunes(length) {
            let result = "";
            for (let i = 0; i < length; i++) {
                result += runes.charAt(Math.floor(Math.random() * runes.length));
            }
            return result;
        }

        const runeInterval = setInterval(() => {
            if(isRunning) {
                runeOutput.innerText = randomRunes(12);
                runeOutput.style.opacity = Math.random() > 0.5 ? 1 : 0.7; 
            }
        }, 80); 

        function stopRunes() {
            if (!isRunning) return; 
            isRunning = false;
            clearInterval(runeInterval);
            runeOutput.innerText = targetText;
            runeOutput.style.opacity = 1;
            // Use CSS var for success color logic
            runeOutput.style.color = "#00ff9d"; 
            runeBox.style.borderColor = "#00ff9d"; 
        }
    </script>
</body>
</html>
