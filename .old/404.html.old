<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404: Connection Refused</title>
    <style>
        :root {
            --bg-color: #0d1117; /* GitHub Dark Dimmed */
            --text-color: #c9d1d9; /* Soft White */
            --error-color: #ff7b72; /* Red for errors */
            --cmd-color: #7ee787; /* Green for user prompt */
            --accent-color: #58a6ff; /* Blue for links */
            --dim-color: #8b949e;
            --font-stack: 'Consolas', 'Monaco', 'Andale Mono', monospace;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-stack);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .terminal-window {
            width: 100%;
            max-width: 700px;
        }

        .prompt { color: var(--cmd-color); font-weight: bold; }
        .path { color: var(--accent-color); }
        .command { color: #fff; }
        
        .error-msg {
            color: var(--error-color);
            margin-top: 1rem;
            margin-bottom: 1rem;
            font-weight: bold;
        }

        .ascii-art {
            font-size: 0.8rem;
            line-height: 1.2;
            white-space: pre;
            color: var(--dim-color);
            margin: 2rem 0;
            opacity: 0.7;
        }

        /* BUTTON STYLING */
        a.home-btn {
            color: var(--bg-color);
            background-color: var(--accent-color);
            text-decoration: none;
            padding: 8px 15px;
            font-weight: bold;
            display: inline-block;
            margin-top: 1rem;
            border: 2px solid var(--accent-color);
            transition: all 0.2s;
        }

        a.home-btn:hover {
            background-color: transparent;
            color: var(--accent-color);
            cursor: pointer;
        }

        /* Blinking Cursor */
        .cursor {
            display: inline-block;
            width: 10px;
            height: 1.2em;
            background-color: var(--cmd-color);
            animation: blink 1s step-end infinite;
            vertical-align: middle;
            margin-left: 5px;
        }

        @keyframes blink { 50% { opacity: 0; } }
    </style>
</head>
<body>

    <div class="terminal-window">
        <div>
            <span class="prompt">root@0x5ha157</span>:<span class="path">/var/www/html</span>$ <span class="command">GET /requested_page</span>
        </div>
        
        <div class="ascii-art">
  _  _    ___  _  _    
 | || |  / _ \| || |   
 | || |_| | | | || |_  
 |__   _| |_| |__   _| 
    |_|  \___/   |_|   
        </div>

        <div class="error-msg">
            bash: /requested_page: No such file or directory <br>
            Error 404: Resource not found on server.
        </div>

        <div style="color: var(--dim-color); margin-bottom: 1.5rem; font-size: 0.9rem;">
            > Checking DNS records... OK <br>
            > Pinging host... 0% packet loss <br>
            > Verifying path... FAILED
        </div>

        <div>
            <span class="prompt">root@0x5ha157</span>:<span class="path">~</span>$ <span class="command">sh ./return_home.sh</span>
        </div>
        
        <br>
        <a href="/" class="home-btn">EXECUTE RETURN HOME</a>
        <span class="cursor"></span>
    </div>

</body>
</html>
