<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>root@0x5ha157:~/packs</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <style>
        :root {
            --bg-color: #0d1117;
            --text-color: #c9d1d9;
            --accent-color: #58a6ff;
            --cmd-color: #7ee787;
            --dim-color: #8b949e;
            --code-bg: #161b22;
            --font-stack: 'Consolas', 'Monaco', 'Andale Mono', monospace;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-stack);
            margin: 0; padding: 2rem; overflow-x: hidden;
        }

        /* --- UI Elements Fix --- */
        .header-wrapper { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            margin-bottom: 2rem; 
            height: 40px; 
        }
        
        .top-info { display: flex; align-items: center; gap: 15px; }
        
        #clock { 
            color: var(--cmd-color); 
            font-weight: bold; 
            font-size: 1.1rem; 
            width: 100px; 
            text-align: right;
            display: inline-block;
        }
        
        .key-display-box {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid #30363d;
            padding: 4px 12px;
            border-radius: 4px;
            width: 140px; 
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            overflow: hidden;
        }

        #decryption-field {
            font-size: 0.85rem;
            letter-spacing: 1px;
            white-space: nowrap;
        }
        .scrambled { color: #b388ff; }
        .revealed { color: var(--cmd-color); font-weight: bold; text-shadow: 0 0 5px rgba(126, 231, 135, 0.4); }

        .nav-bar { margin-bottom: 0; }
        .back-btn {
            display: inline-flex; align-items: center; padding: 8px 16px;
            background: var(--code-bg); color: var(--accent-color);
            text-decoration: none; border: 1px solid #30363d;
            border-radius: 6px; font-size: 0.9rem; font-weight: bold;
        }

        .terminal-header {
            margin-top: 1rem; margin-bottom: 2rem;
            border-bottom: 1px solid #30363d; padding-bottom: 1rem;
            display: flex; justify-content: space-between; align-items: center;
        }
        .prompt { color: var(--cmd-color); font-weight: bold; }
        .path { color: var(--accent-color); }

        /* --- Password Styling --- */
        #auth-screen { display: flex; flex-direction: column; margin-top: 5vh; }
        .input-line { display: flex; align-items: center; }
        input#password-input {
            background: transparent; border: none; color: white;
            font-family: var(--font-stack); font-size: 1rem;
            outline: none; margin-left: 10px; width: 50%;
        }
        .access-denied { color: #ff6b6b; display: none; margin-top: 1rem; }

        /* --- Grid Logic --- */
        #gallery-container { display: none; }
        .folder-section { margin-bottom: 1rem; margin-left: 25px; border-left: 1px solid #30363d; padding-left: 15px; }
        #content-area > .folder-section { margin-left: 0; border-left: none; padding-left: 0; }
        .collapsed > .grid, .collapsed > .folder-section { display: none !important; }
        
        .folder-header { 
            display: flex; justify-content: space-between; align-items: center; 
            border-bottom: 1px dashed #30363d; padding-bottom: 0.5rem; margin-bottom: 1rem;
            cursor: pointer;
        }
        .folder-title { font-size: 1.1rem; color: var(--accent-color); margin: 0; }
        .toggle-icon { font-family: monospace; margin-right: 10px; color: var(--dim-color); }
        .collapsed .toggle-icon::before { content: "[+]"; }
        .expanded .toggle-icon::before { content: "[-]"; }

        .grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1.5rem; margin-top: 1rem;
        }
        .file-card {
            background: var(--code-bg); border: 1px solid #30363d;
            border-radius: 6px; padding: 0.5rem; height: 260px;
            display: flex; flex-direction: column; cursor: pointer;
        }
        .thumb-area {
            width: 100%; height: 180px; display: flex; align-items: center; 
            justify-content: center; background: rgba(0,0,0,0.2); overflow: hidden;
        }
        .thumb-area img { width: 100%; height: 100%; object-fit: cover; }
        .file-name { font-size: 0.75rem; color: var(--dim-color); text-align: center; margin-top: 10px; }

        #lightbox {
            display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%;
            background-color: rgba(0,0,0,0.95); align-items: center; justify-content: center;
        }
        .viewer-element { display: none; max-width: 90%; max-height: 80vh; }
        .close { position: absolute; top: 20px; right: 30px; font-size: 2.5rem; color: #fff; cursor: pointer; }

        @keyframes blink { 50% { opacity: 0; } }
        .cursor { display: inline-block; width: 10px; height: 1.2em; background: var(--cmd-color); animation: blink 1s step-end infinite; }
    </style>
</head>
<body>

    <div class="header-wrapper">
        <div class="nav-bar">
            <a href="/" class="back-btn">cd .. (Dashboard)</a>
        </div>
        <div class="top-info">
            <div class="key-display-box" onclick="copyToClipboard()">
                <span id="decryption-field" class="scrambled">INITIALIZING...</span>
            </div>
            <div id="clock">00:00:00</div>
        </div>
    </div>

    <div class="terminal-header">
        <div><span class="prompt">root@0x5ha157</span>:<span class="path">~/packs</span># <span style="color:#fff">./UniversalViewer_v10.sh</span></div>
        <button id="collapse-all-btn" style="background:transparent; border:1px solid var(--dim-color); color:var(--dim-color); padding:4px 12px; cursor:pointer;" onclick="toggleAllFolders()">expand_all.sh</button>
    </div>

    <div id="auth-screen">
        <p>Protected Directory. Enter Access Key:</p>
        <div class="input-line">
            <span class="prompt">key:</span>
            <input type="password" id="password-input" autofocus autocomplete="off">
        </div>
        <p class="access-denied" id="error-msg">ACCESS DENIED. Key Expired or Invalid.</p>
    </div>

    <div id="gallery-container">
        <div id="status-log" style="color: var(--dim-color); margin-bottom: 1rem; font-size: 0.85rem;"></div>
        <div id="content-area"></div>
        <div style="margin-top: 20px;">
            <span class="prompt">root@0x5ha157</span>:<span class="path">~/packs</span>$ <span class="cursor"></span>
        </div>
    </div>

    <div id="lightbox">
        <span class="close" onclick="closeLightbox()">&times;</span>
        <img id="lb-img" class="viewer-element">
        <video id="lb-video" class="viewer-element" controls></video>
        <iframe id="lb-frame" class="viewer-element"></iframe>
        <div id="lb-text" style="color:white; white-space:pre-wrap; padding:20px;" class="viewer-element"></div>
    </div>

    <script>
        // --- CONFIG ---
        const MASTER_KEY = "0x5ha11321"; 
        const SCAN_DIR = "./data/";
        const SGA_CHARS = "ᔑʖᓵ↸ᒣᒲ⎓⊣⍑╎⋮ꖎᒲリ𝙹!¡ᑫ∷ᓊℸᒲ⎓⊣";
        
        // --- STATE ---
        let generatedKey = ""; // Stores the rotating OTP
        let GLOBAL_FILE_LIST = []; 
        let FOLDER_STRUCTURE = {};

        // --- KEY ROTATION LOGIC (Restored) ---
        function generateOTP() {
            const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"; // Removed similar chars like I,1,O,0
            let result = "";
            for (let i = 0; i < 8; i++) {
                result += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            generatedKey = result;
            
            // Console Warning with Icon (Restored)
            console.warn(`⚠️ [SYSTEM ALERT] New Access Key Generated: ${generatedKey}`);
        }
        
        // Start rotation immediately and cycle every 30s
        generateOTP();
        setInterval(generateOTP, 30000);

        // --- UI & CLOCK LOGIC ---
        function updateSystemState() {
            const now = new Date();
            const seconds = now.getSeconds();
            const clockEl = document.getElementById('clock');
            const keyEl = document.getElementById('decryption-field');

            // Update Clock
            clockEl.innerText = now.toTimeString().split(' ')[0];

            // 30s Cycle Logic: 0-20s Scramble, 20-30s Reveal
            const cyclePos = seconds % 30;

            if (cyclePos < 20) {
                // Scramble Mode
                let randomString = "";
                for(let i=0; i < 8; i++) {
                    randomString += SGA_CHARS.charAt(Math.floor(Math.random() * SGA_CHARS.length));
                }
                keyEl.innerText = randomString;
                keyEl.className = "scrambled";
            } else {
                // Reveal Mode (Shows the ACTUAL generated key)
                keyEl.innerText = generatedKey;
                keyEl.className = "revealed";
            }
        }
        setInterval(updateSystemState, 100);

        // --- AUTHENTICATION ---
        document.getElementById('password-input').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                const inputVal = e.target.value;
                // Check against Master Key OR Rotating Generated Key
                if (inputVal === MASTER_KEY || inputVal === generatedKey) {
                    document.getElementById('auth-screen').style.display = 'none';
                    document.getElementById('gallery-container').style.display = 'block';
                    initGallery();
                } else {
                    document.getElementById('error-msg').style.display = 'block';
                    e.target.value = '';
                }
            }
        });

        // --- CLIPBOARD ---
        function copyToClipboard() {
            const keyEl = document.getElementById('decryption-field');
            if (keyEl.className === "revealed") {
                navigator.clipboard.writeText(keyEl.innerText);
                const original = keyEl.innerText;
                keyEl.innerText = "COPIED!";
                setTimeout(() => keyEl.innerText = original, 1000);
            }
        }

        // --- SCANNER LOGIC (Untouched) ---
        async function initGallery() {
            await deepScan(SCAN_DIR);
            renderTree();
        }

        async function deepScan(path) {
            try {
                const res = await fetch(path);
                if (!res.ok) return;
                const text = await res.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(text, 'text/html');
                const links = Array.from(doc.querySelectorAll('a')).map(a => a.getAttribute('href'));
                
                // Heuristics for Apache/Nginx directory listing
                const files = links.filter(l => !l.endsWith('/') && !l.startsWith('?') && !l.startsWith('..'));
                const folders = links.filter(l => l.endsWith('/') && l !== '/' && !l.includes('..'));
                
                FOLDER_STRUCTURE[path] = files;
                for (const f of folders) { await deepScan(path + f); }
            } catch (e) {}
        }

        function renderTree() {
            const paths = Object.keys(FOLDER_STRUCTURE).sort();
            paths.forEach(path => createFolderElement(path, FOLDER_STRUCTURE[path]));
        }

        function createFolderElement(folderPath, files) {
            const container = document.getElementById('content-area');
            const pathParts = folderPath.split('/').filter(p => p && p !== '.');
            const cleanName = pathParts[pathParts.length - 1] || "root";
            const sanitizedId = "dir-" + folderPath.replace(/[^a-zA-Z0-9]/g, '-');
            
            const section = document.createElement('div');
            section.className = 'folder-section collapsed'; 
            section.id = sanitizedId;
            section.innerHTML = `
                <div class="folder-header" onclick="toggleSingleFolder(this)">
                    <h2 class="folder-title"><span class="toggle-icon"></span>/${cleanName}</h2>
                </div>
                <div class="grid"></div>`;
            
            const grid = section.querySelector('.grid');
            files.forEach(file => {
                const fullUrl = folderPath + file;
                const ext = file.split('.').pop().toLowerCase();
                const gIndex = GLOBAL_FILE_LIST.length;
                GLOBAL_FILE_LIST.push({ url: fullUrl, name: file, type: ext });
                
                let thumb = `<div style="font-size:3rem">📄</div>`;
                if(['jpg','jpeg','png','gif','webp'].includes(ext)) thumb = `<img src="${fullUrl}" loading="lazy">`;
                
                grid.innerHTML += `<div class="file-card" onclick="openUniversalViewer(${gIndex})"><div class="thumb-area">${thumb}</div><div class="file-name">${file}</div></div>`;
            });

            // Logic to nest folders if parent exists
            const parentPath = folderPath.substring(0, folderPath.lastIndexOf('/', folderPath.length - 2) + 1);
            const parentId = "dir-" + parentPath.replace(/[^a-zA-Z0-9]/g, '-');
            const parentEl = document.getElementById(parentId);
            
            if (parentEl && folderPath !== SCAN_DIR) parentEl.appendChild(section);
            else container.appendChild(section);
        }

        function toggleSingleFolder(header) {
            header.parentElement.classList.toggle('collapsed');
            header.parentElement.classList.toggle('expanded');
        }

        function toggleAllFolders() {
            const all = document.querySelectorAll('.folder-section');
            const btn = document.getElementById('collapse-all-btn');
            const isExp = btn.innerText === "expand_all.sh";
            all.forEach(f => {
                if (isExp) { f.classList.remove('collapsed'); f.classList.add('expanded'); }
                else { f.classList.add('collapsed'); f.classList.remove('expanded'); }
            });
            btn.innerText = isExp ? "collapse_all.sh" : "expand_all.sh";
        }

        function openUniversalViewer(index) {
            const data = GLOBAL_FILE_LIST[index];
            const box = document.getElementById('lightbox');
            const img = document.getElementById('lb-img');
            const vid = document.getElementById('lb-video');
            const frame = document.getElementById('lb-frame');
            
            // Reset
            [img, vid, frame].forEach(el => el.style.display = 'none');
            box.style.display = "flex";
            
            if(['jpg','jpeg','png','gif','webp'].includes(data.type)) {
                img.src = data.url; img.style.display = "block";
            }
        }
        function closeLightbox() { document.getElementById('lightbox').style.display = "none"; }
    </script>
</body>
</html>
