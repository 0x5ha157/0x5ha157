<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>root@0x5ha157:~/packs</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <style>
        :root {
            --bg-color: #0d1117;
            --text-color: #c9d1d9;
            --accent-color: #58a6ff;
            --cmd-color: #7ee787;
            --dim-color: #8b949e;
            --code-bg: #161b22;
            --font-stack: 'Consolas', 'Monaco', 'Andale Mono', monospace;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-stack);
            margin: 0; padding: 2rem; overflow-x: hidden;
        }

        /* --- UI Elements --- */
        .header-wrapper { display: flex; justify-content: space-between; align-items: flex-start; }
        #clock { color: var(--cmd-color); font-weight: bold; font-size: 1.1rem; }
        
        .nav-bar { margin-bottom: 2rem; }
        .back-btn {
            display: inline-flex; align-items: center; padding: 8px 16px;
            background: var(--code-bg); color: var(--accent-color);
            text-decoration: none; border: 1px solid #30363d;
            border-radius: 6px; font-size: 0.9rem; font-weight: bold;
            transition: all 0.2s;
        }
        .back-btn:hover {
            background: #30363d; color: white; border-color: var(--accent-color);
            transform: translateX(-3px);
        }

        .terminal-header {
            margin-top: 1rem; margin-bottom: 2rem;
            border-bottom: 1px solid #30363d; padding-bottom: 1rem;
            display: flex; justify-content: space-between; align-items: center;
        }
        .prompt { color: var(--cmd-color); font-weight: bold; }
        .path { color: var(--accent-color); }
        .command { color: #fff; }

        /* --- Password Styling --- */
        #auth-screen { display: flex; flex-direction: column; margin-top: 5vh; }
        .input-line { display: flex; align-items: center; }
        input#password-input {
            background: transparent; border: none; color: white;
            font-family: var(--font-stack); font-size: 1rem;
            outline: none; margin-left: 10px; width: 50%;
            caret-color: var(--cmd-color);
        }
        .access-denied { color: #ff6b6b; display: none; margin-top: 1rem; }

        /* --- Nesting & Collapse Logic --- */
        .folder-section { 
            margin-bottom: 1rem; 
            margin-left: 25px; 
            border-left: 1px solid #30363d; 
            padding-left: 15px;
            animation: fadeIn 0.3s ease-in; 
        }
        #content-area > .folder-section { margin-left: 0; border-left: none; padding-left: 0; }

        .folder-header { 
            display: flex; justify-content: space-between; align-items: center; 
            border-bottom: 1px dashed #30363d; padding-bottom: 0.5rem; margin-bottom: 1rem;
            cursor: pointer;
        }
        .folder-title { font-size: 1.1rem; color: var(--accent-color); margin: 0; display: flex; align-items: center; }
        
        .toggle-icon { font-family: monospace; margin-right: 10px; color: var(--dim-color); width: 25px; }

        /* Collapsed by default */
        .collapsed > .grid, .collapsed > .folder-section { display: none !important; }
        .collapsed .toggle-icon::before { content: "[+]"; }
        .expanded .toggle-icon::before { content: "[-]"; }

        #collapse-all-btn {
            background: transparent; border: 1px solid var(--dim-color); color: var(--dim-color);
            padding: 4px 12px; border-radius: 4px; cursor: pointer; font-size: 0.8rem;
        }
        #collapse-all-btn:hover { border-color: var(--accent-color); color: var(--accent-color); }

        /* --- Gallery Grid --- */
        #gallery-container { display: none; }
        .zip-btn { 
            background: transparent; border: 1px solid var(--cmd-color); color: var(--cmd-color);
            padding: 4px 10px; cursor: pointer; border-radius: 4px; font-size: 0.8rem;
        }
        .zip-btn:hover { background: var(--cmd-color); color: var(--bg-color); }

        .grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1.5rem; margin-top: 1rem; margin-bottom: 1rem;
        }
        
        .file-card {
            background: var(--code-bg); border: 1px solid #30363d;
            border-radius: 6px; padding: 0.5rem; transition: 0.2s;
            cursor: pointer; display: flex; flex-direction: column; height: 260px;
        }
        .file-card:hover { transform: translateY(-5px); border-color: var(--accent-color); }

        .thumb-area {
            width: 100%; height: 180px; display: flex; align-items: center; 
            justify-content: center; background: rgba(0,0,0,0.2); border-radius: 4px; overflow: hidden;
        }
        .thumb-area img { width: 100%; height: 100%; object-fit: cover; }
        .file-icon { font-size: 3.5rem; color: var(--dim-color); }

        .file-info { margin-top: auto; padding: 5px; }
        .file-name {
            font-size: 0.75rem; color: var(--dim-color);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center;
        }
        .dl-icon-btn {
            display: block; text-align: center; color: var(--accent-color); 
            text-decoration: none; font-size: 0.8rem; margin-top: 5px;
        }

        /* --- LIGHTBOX --- */
        #lightbox {
            display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%;
            background-color: rgba(0,0,0,0.95); backdrop-filter: blur(5px);
            align-items: center; justify-content: center; flex-direction: column;
        }
        .viewer-element { display: none; max-width: 90%; max-height: 80vh; border: 1px solid #30363d; }
        #lb-video { width: 80%; }
        #lb-frame { width: 80%; height: 80vh; background: white; }
        #lb-text { 
            width: 80%; height: 80vh; background: #0d1117; padding: 2rem; 
            overflow: auto; color: #e6edf3; font-family: var(--font-stack); white-space: pre-wrap;
        }
        .lb-btn {
            position: absolute; top: 50%; transform: translateY(-50%);
            background: rgba(255,255,255,0.1); border: none; color: white;
            padding: 15px; cursor: pointer; font-size: 2rem; transition: 0.2s;
        }
        .lb-btn:hover { background: var(--accent-color); color: black; }
        .prev { left: 20px; }
        .next { right: 20px; }
        .close { position: absolute; top: 20px; right: 30px; font-size: 2.5rem; color: #fff; cursor: pointer; }

        .cursor {
            display: inline-block; width: 10px; height: 1.2em;
            background-color: var(--cmd-color); animation: blink 1s step-end infinite; vertical-align: sub;
        }
        @keyframes blink { 50% { opacity: 0; } }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    </style>
</head>
<body>

    <div class="header-wrapper">
        <div class="nav-bar">
            <a href="/" class="back-btn">cd .. (Dashboard)</a>
        </div>
        <div id="clock">00:00:00</div>
    </div>

    <div class="terminal-header">
        <div>
            <span class="prompt">root@0x5ha157</span>:<span class="path">~/packs</span># <span class="command">./UniversalViewer_v5.sh</span>
        </div>
        <button id="collapse-all-btn" onclick="toggleAllFolders()">expand_all.sh</button>
    </div>

    <div id="auth-screen">
        <p>Protected Directory. Enter Access Key:</p>
        <div class="input-line">
            <span class="prompt">key:</span>
            <input type="password" id="password-input" autofocus autocomplete="off">
        </div>
        <p class="access-denied" id="error-msg">ACCESS DENIED.</p>
    </div>

    <div id="gallery-container">
        <div id="status-log" style="color: var(--dim-color); margin-bottom: 1rem; font-size: 0.85rem;"></div>
        <div id="content-area"></div>
        <div style="margin-top: 20px;">
            <span class="prompt">root@0x5ha157</span>:<span class="path">~/packs</span>$ <span class="cursor"></span>
        </div>
    </div>

    <div id="lightbox">
        <span class="close" onclick="closeLightbox()">&times;</span>
        <img id="lb-img" class="viewer-element">
        <video id="lb-video" class="viewer-element" controls></video>
        <iframe id="lb-frame" class="viewer-element"></iframe>
        <div id="lb-text" class="viewer-element"></div>
        <div id="lb-caption" style="margin-top:10px;"></div>
        <button class="lb-btn prev" onclick="changeSlide(-1)">&#10094;</button>
        <button class="lb-btn next" onclick="changeSlide(1)">&#10095;</button>
    </div>

    <script>
        const MASTER_KEY = "0x5ha11321"; 
        const SCAN_DIR = "./data/";
        let GLOBAL_FILE_LIST = []; 
        let FOLDER_STRUCTURE = {};

        function updateClock() {
            const now = new Date();
            document.getElementById('clock').innerText = now.toTimeString().split(' ')[0];
        }
        setInterval(updateClock, 1000);
        updateClock();

        const passInput = document.getElementById('password-input');
        passInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                if (passInput.value === MASTER_KEY) {
                    document.getElementById('auth-screen').style.display = 'none';
                    document.getElementById('gallery-container').style.display = 'block';
                    initGallery();
                } else {
                    document.getElementById('error-msg').style.display = 'block';
                    passInput.value = '';
                }
            }
        });

        function log(msg) { document.getElementById('status-log').innerText += msg + "\n"; }

        async function initGallery() {
            log("[SYSTEM] Scanning recursively...");
            await deepScan(SCAN_DIR);
            renderTree();
            log("[SYSTEM] Scanning complete.");
        }

        async function deepScan(path) {
            try {
                const res = await fetch(path);
                if (!res.ok) return;
                const text = await res.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(text, 'text/html');
                const links = Array.from(doc.querySelectorAll('a')).map(a => a.getAttribute('href'));

                const files = links.filter(l => !l.endsWith('/') && !l.startsWith('?') && !l.startsWith('..'));
                const folders = links.filter(l => l.endsWith('/') && l !== '/' && !l.includes('..'));

                FOLDER_STRUCTURE[path] = files;
                for (const f of folders) { await deepScan(path + f); }
            } catch (e) { console.error(e); }
        }

        function renderTree() {
            const paths = Object.keys(FOLDER_STRUCTURE).sort();
            paths.forEach(path => {
                createFolderElement(path, FOLDER_STRUCTURE[path]);
            });
        }

        function createFolderElement(folderPath, files) {
            const container = document.getElementById('content-area');
            const pathParts = folderPath.split('/').filter(p => p && p !== '.');
            const cleanName = pathParts[pathParts.length - 1] || "root";
            const sanitizedId = "dir-" + folderPath.replace(/[^a-zA-Z0-9]/g, '-');
            
            const section = document.createElement('div');
            // UPDATED: Start with 'collapsed' instead of 'expanded'
            section.className = 'folder-section collapsed'; 
            section.id = sanitizedId;
            section.innerHTML = `
                <div class="folder-header" onclick="toggleSingleFolder(this)">
                    <h2 class="folder-title"><span class="toggle-icon"></span>/${cleanName}</h2>
                    <button class="zip-btn" onclick="event.stopPropagation(); zipFolder('${folderPath}', '${cleanName}')">Download .ZIP</button>
                </div>
                <div class="grid"></div>`;
            
            const grid = section.querySelector('.grid');
            files.forEach(file => {
                const fullUrl = folderPath + file;
                const ext = file.split('.').pop().toLowerCase();
                const gIndex = GLOBAL_FILE_LIST.length;
                GLOBAL_FILE_LIST.push({ url: fullUrl, name: file, type: ext });

                let thumb = `<div class="file-icon">📄</div>`;
                if(['jpg','jpeg','png','gif','webp'].includes(ext)) thumb = `<img src="${fullUrl}" loading="lazy">`;
                else if(['mp4','webm','mov'].includes(ext)) thumb = `<div class="file-icon">🎬</div>`;
                else if(ext === 'pdf') thumb = `<div class="file-icon">📕</div>`;

                grid.innerHTML += `
                    <div class="file-card" onclick="event.stopPropagation(); openUniversalViewer(${gIndex})">
                        <div class="thumb-area">${thumb}</div>
                        <div class="file-info">
                            <div class="file-name">${file}</div>
                            <a href="${fullUrl}" download class="dl-icon-btn" onclick="event.stopPropagation()">Download ↓</a>
                        </div>
                    </div>`;
            });

            const parentPath = folderPath.substring(0, folderPath.lastIndexOf('/', folderPath.length - 2) + 1);
            const parentId = "dir-" + parentPath.replace(/[^a-zA-Z0-9]/g, '-');
            const parentEl = document.getElementById(parentId);

            if (parentEl && folderPath !== SCAN_DIR) {
                parentEl.appendChild(section);
            } else {
                container.appendChild(section);
            }
        }

        function toggleSingleFolder(header) {
            header.parentElement.classList.toggle('collapsed');
            header.parentElement.classList.toggle('expanded');
        }

        function toggleAllFolders() {
            const allFolders = document.querySelectorAll('.folder-section');
            const btn = document.getElementById('collapse-all-btn');
            // If button says expand, we expand everything
            const isExpanding = btn.innerText === "expand_all.sh";

            allFolders.forEach(f => {
                if (isExpanding) {
                    f.classList.remove('collapsed'); f.classList.add('expanded');
                } else {
                    f.classList.add('collapsed'); f.classList.remove('expanded');
                }
            });
            btn.innerText = isExpanding ? "collapse_all.sh" : "expand_all.sh";
        }

        async function zipFolder(path, folderName) {
            const zip = new JSZip();
            log(`[SYSTEM] Zipping ${folderName}...`);
            const folderFiles = GLOBAL_FILE_LIST.filter(f => f.url.startsWith(path));
            for(let f of folderFiles) {
                const res = await fetch(f.url);
                zip.file(f.name, await res.blob());
            }
            zip.generateAsync({type:"blob"}).then(content => {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(content);
                link.download = `${folderName}.zip`;
                link.click();
            });
        }

        const lb = {
            box: document.getElementById('lightbox'),
            img: document.getElementById('lb-img'),
            vid: document.getElementById('lb-video'),
            iframe: document.getElementById('lb-frame'),
            txt: document.getElementById('lb-text'),
            cap: document.getElementById('lb-caption')
        };

        async function openUniversalViewer(index) {
            currentFileIndex = index;
            lb.box.style.display = "flex";
            await loadContent();
        }

        async function loadContent() {
            Object.values(lb).forEach(el => { if(el.className === 'viewer-element') el.style.display = 'none'; });
            lb.vid.pause();
            const data = GLOBAL_FILE_LIST[currentFileIndex];
            lb.cap.innerText = `${data.name} (${currentFileIndex + 1}/${GLOBAL_FILE_LIST.length})`;

            if (['jpg','jpeg','png','gif','webp'].includes(data.type)) {
                lb.img.src = data.url; lb.img.style.display = 'block';
            } else if (['mp4','webm','mov'].includes(data.type)) {
                lb.vid.src = data.url; lb.vid.style.display = 'block';
            } else if (data.type === 'pdf') {
                lb.iframe.src = data.url; lb.iframe.style.display = 'block';
            } else {
                lb.txt.style.display = 'block';
                lb.txt.innerText = "Loading...";
                const res = await fetch(data.url);
                lb.txt.innerText = res.ok ? await res.text() : "Error.";
            }
        }

        function closeLightbox() { lb.box.style.display = "none"; lb.vid.pause(); }
        function changeSlide(n) {
            currentFileIndex = (currentFileIndex + n + GLOBAL_FILE_LIST.length) % GLOBAL_FILE_LIST.length;
            loadContent();
        }
    </script>
</body>
</html>
