<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>root@0x5ha157:~/packs</title>
    <style>
        :root {
            --bg-color: #0d1117;
            --text-color: #c9d1d9;
            --accent-color: #58a6ff;
            --cmd-color: #7ee787;
            --dim-color: #8b949e;
            --code-bg: #161b22;
            --font-stack: 'Consolas', 'Monaco', 'Andale Mono', monospace;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-stack);
            margin: 0;
            padding: 2rem;
        }

        /* --- UI Elements --- */
        .nav-bar {
            margin-bottom: 2rem;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            padding: 8px 16px;
            background: var(--code-bg);
            color: var(--accent-color);
            text-decoration: none;
            border: 1px solid #30363d;
            border-radius: 6px;
            font-size: 0.9rem;
            font-weight: bold;
            transition: all 0.2s;
        }
        .back-btn:hover {
            background: #30363d;
            color: white;
            border-color: var(--accent-color);
            transform: translateX(-3px);
        }

        .terminal-header {
            margin-top: 1rem;
            margin-bottom: 2rem;
            border-bottom: 1px solid #30363d;
            padding-bottom: 1rem;
        }
        .prompt { color: var(--cmd-color); font-weight: bold; }
        .path { color: var(--accent-color); }
        .command { color: #fff; }

        /* --- Auth Screen --- */
        #auth-screen { display: flex; flex-direction: column; margin-top: 5vh; }
        .input-line { display: flex; align-items: center; }
        input#password-input {
            background: transparent; border: none; color: white;
            font-family: var(--font-stack); font-size: 1rem;
            outline: none; margin-left: 10px; width: 50%;
            caret-color: var(--cmd-color);
        }
        .access-denied { color: #ff6b6b; display: none; margin-top: 1rem; }
        .hint { font-size: 0.8rem; color: var(--dim-color); margin-top: 2rem; opacity: 0.6; }

        /* --- Gallery --- */
        #gallery-container { display: none; }
        .folder-section { margin-bottom: 3rem; animation: fadeIn 0.5s ease-in; }
        .folder-title {
            font-size: 1.2rem; color: var(--accent-color);
            border-bottom: 1px dashed #30363d; padding-bottom: 0.5rem; margin-bottom: 1rem;
        }
        .grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1.5rem;
        }
        .img-card {
            background: var(--code-bg); border: 1px solid #30363d;
            border-radius: 6px; padding: 0.5rem; transition: transform 0.2s;
        }
        .img-card:hover { transform: translateY(-5px); border-color: var(--accent-color); }
        .img-card img {
            width: 100%; height: 200px; object-fit: cover;
            border-radius: 4px; display: block;
        }
        .img-name {
            font-size: 0.75rem; color: var(--dim-color); margin-top: 0.5rem;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        /* --- Cursor --- */
        .cursor {
            display: inline-block; width: 10px; height: 1.2em;
            background-color: var(--cmd-color);
            animation: blink 1s step-end infinite; vertical-align: sub;
        }
        @keyframes blink { 50% { opacity: 0; } }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    </style>
</head>
<body>

    <div class="nav-bar">
        <a href="/" class="back-btn">cd .. (Dashboard)</a>
    </div>

    <div class="terminal-header">
        <span class="prompt">root@aboutwebsite</span>:<span class="path">/var/www/html/packs</span># <span class="command">./view_gallery.sh</span>
    </div>

    <div id="auth-screen">
        <p>Protected Directory. Enter Access Key:</p>
        <div class="input-line">
            <span class="prompt">key:</span>
            <input type="password" id="password-input" autofocus autocomplete="off">
        </div>
        <p class="access-denied" id="error-msg">ACCESS DENIED. Invalid Key.</p>
        
        <p class="hint">
            [HINT] Security Protocol Active: Key rotates every 30s.<br>
            [HINT] Check system logs (F12 Console) for current OTP.
        </p>
    </div>

    <div id="gallery-container">
        <div id="status-log" style="color: var(--dim-color); margin-bottom: 2rem; white-space: pre-wrap;"></div>
        <div id="content-area"></div>
        <br>
        <div style="margin-top: 20px;">
            <span class="prompt">root@aboutwebsite</span>:<span class="path">~/packs</span>$ <span class="cursor"></span>
        </div>
    </div>

    <script>
        // --- CONFIGURATION ---
        const MASTER_KEY = "0x5ha11321"; // Always works
        const SCAN_DIR = "./data/";      // Folder to scan
        
        let currentOTP = "";
        let timer = null;

        // --- OTP GENERATOR ---
        function generateOTP() {
            const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$";
            let result = "";
            for (let i = 0; i < 8; i++) {
                result += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            return result;
        }

        function startOTPService() {
            // Generate immediately
            rotateKey();
            
            // Set interval for 30 seconds
            timer = setInterval(rotateKey, 30000);
        }

        function rotateKey() {
            currentOTP = generateOTP();
            console.clear();
            console.log("%c [SECURE SYSTEM LOG] ", "background: #2ea043; color: #fff; font-weight: bold;");
            console.log("%c NEW ACCESS KEY GENERATED: " + currentOTP, "color: #58a6ff; font-size: 1.2rem; font-family: monospace;");
            console.log("%c (Valid for 30 seconds)", "color: #8b949e;");
        }

        // Start the engine
        startOTPService();

        // --- AUTH LOGIC ---
        const passInput = document.getElementById('password-input');
        passInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                const inputVal = passInput.value;
                
                // Check Master Key OR Dynamic OTP
                if (inputVal === MASTER_KEY || inputVal === currentOTP) {
                    
                    // Success
                    document.getElementById('auth-screen').style.display = 'none';
                    document.getElementById('gallery-container').style.display = 'block';
                    log("Access Granted.\n[SYSTEM] Initializing scan...");
                    
                    // Stop rotating keys once logged in (optional, saves resources)
                    clearInterval(timer);
                    console.log("%c [SYSTEM] User Authenticated. Log rotation stopped.", "color: #2ea043");
                    
                    initGallery();
                
                } else {
                    // Fail
                    document.getElementById('error-msg').style.display = 'block';
                    passInput.value = '';
                    console.warn("[SECURITY] Failed login attempt.");
                }
            }
        });

        function log(msg) {
            document.getElementById('status-log').innerText += msg + "\n";
        }

        // --- SCANNING LOGIC ---
        async function initGallery() {
            try {
                const response = await fetch(SCAN_DIR);
                
                if (!response.ok) {
                    log(`[ERROR] Server returned ${response.status} for '${SCAN_DIR}'.`);
                    return;
                }

                const text = await response.text();

                if (text.includes('<title>root@0x5ha157')) {
                    log("[ERROR] Loop detected! You must move your images into the 'data' subfolder.");
                    return;
                }

                const parser = new DOMParser();
                const doc = parser.parseFromString(text, 'text/html');
                const links = Array.from(doc.querySelectorAll('a'));

                const folders = links
                    .map(a => a.getAttribute('href'))
                    .filter(href => {
                        return href.endsWith('/') && href !== '/' && !href.startsWith('?') && !href.includes('Parent Directory');
                    });

                log(`[SYSTEM] Found ${folders.length} directories in ${SCAN_DIR}`);

                for (const folder of folders) {
                    await scanFolder(folder);
                }
                
                log("[SYSTEM] Rendering Complete.");

            } catch (err) {
                log("[ERROR] Connection Failed.");
                console.error(err);
            }
        }

        async function scanFolder(folderName) {
            try {
                const fullPath = SCAN_DIR + folderName;
                const res = await fetch(fullPath);
                const text = await res.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(text, 'text/html');
                const links = Array.from(doc.querySelectorAll('a'));

                const images = links
                    .map(a => a.getAttribute('href'))
                    .filter(href => href.match(/\.(jpeg|jpg|png|gif|webp)$/i));

                if (images.length > 0) {
                    renderFolder(folderName, images, fullPath);
                }

            } catch (err) {
                console.log(`Empty or unreadable: ${folderName}`);
            }
        }

        function renderFolder(name, images, basePath) {
            const container = document.getElementById('content-area');
            const section = document.createElement('div');
            section.className = 'folder-section';
            
            const cleanName = name.replace(/\/$/, '');

            section.innerHTML = `<h2 class="folder-title">${cleanName}</h2><div class="grid"></div>`;
            const grid = section.querySelector('.grid');

            images.forEach(img => {
                const imgUrl = basePath + img;
                grid.innerHTML += `
                    <div class="img-card">
                        <a href="${imgUrl}" target="_blank">
                            <img src="${imgUrl}" loading="lazy">
                        </a>
                        <div class="img-name">${img}</div>
                    </div>
                `;
            });
            container.appendChild(section);
        }
    </script>
</body>
</html>
