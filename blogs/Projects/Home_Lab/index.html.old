<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>root@0x5ha157:~/blog</title>
    <style>
        /* SAME CSS AS RESUME */
        :root {
            --bg-color: #0d1117;
            --text-color: #c9d1d9;
            --accent-color: #58a6ff;
            --cmd-color: #7ee787;
            --dim-color: #8b949e;
            --dir-color: #79c0ff; /* Folder color */
            --body-font: 'Consolas', 'Monaco', 'Andale Mono', monospace;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--body-font);
            padding: 2rem;
            max-width: 900px;
            margin: 0 auto;
        }

        a { text-decoration: none; color: inherit; }
        a:hover { color: var(--accent-color); }

        .prompt { color: var(--cmd-color); font-weight: bold; }
        .path { color: var(--accent-color); }
        .command { color: #fff; }

        /* Blog List Table Styling */
        .file-list {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1rem;
            font-size: 0.95rem;
        }

        .file-list th { text-align: left; border-bottom: 1px solid #30363d; padding-bottom: 10px; color: var(--dim-color); }
        .file-list td { padding: 8px 0; }
        
        .permissions { color: var(--dim-color); font-size: 0.85rem; }
        .size { color: var(--dim-color); text-align: right; padding-right: 20px; }
        .date { color: var(--dim-color); padding-right: 20px; }
        .filename { color: var(--text-color); font-weight: bold; }
        .filename a:hover { text-decoration: underline; color: var(--accent-color); }
        
        /* Directory Link */
        .dir { color: var(--dir-color); font-weight: bold; }

        @media (max-width: 600px) {
            .permissions, .size { display: none; } /* Hide details on mobile */
        }

        /* --- ADDED THIS SECTION TO FIX BLINKING --- */
        .cursor {
            font-weight: bold;
            color: var(--cmd-color);
            animation: blink 1s step-end infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }
        /* ------------------------------------------ */
    </style>
</head>
<body>

    <div style="margin-bottom: 2rem;">
        <span class="prompt">root@0x5ha157</span>:<span class="path">~</span>$ <span class="command">cd blog/Home_Lab/</span><br>
        <span class="prompt">root@0x5ha157</span>:<span class="path">~/blog/Home_Lab</span>$ <span class="command">ls -lah</span>
    </div>

    <table class="file-list">
        <thead>
            <tr>
                <th class="permissions">Permissions</th>
                <th class="size">Size</th>
                <th class="date">Date Modified</th>
                <th class="name">Name</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="permissions">drwxr-xr-x</td>
                <td class="size">4.0K</td>
                <td class="date">Feb 10 13:00</td>
                <td class="filename dir"><a href="../">../ (cd /Blogs/)</a></td>
            </tr>

            <tr>
                <td class="permissions">-rw-r--r--</td>
                <td class="size">5.4K</td>
                <td class="date">Jan 28 09:15</td>
                <td class="filename"><a href="Cisco_SFP_10G.html">Cisco_SFP_10G.md</a></td>
            </tr>
              <tr>
                <td class="permissions">-rw-r--r--</td>
                <td class="size">5.4K</td>
                <td class="date">Feb 27 17:52</td>
                <td class="filename"><a href="Cisco_PPPoE_1841.html">1841_c0r3_n3tw0rk.md</a></td>
            </tr>
        </tbody>
    </table>

    <div style="margin-top: 2rem; color: var(--dim-color);">
        <span class="prompt">root@0x5ha157</span>:<span class="path">~/blog/Home_Lab</span>$ <span class="cursor">_</span>
    </div>

</body>
</html>
